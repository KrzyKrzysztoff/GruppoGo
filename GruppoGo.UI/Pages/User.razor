@page "/user"
@using GruppoGo.Common.Reponses

<PageTitle>User</PageTitle>
@inject HttpClient httpClient

<div style=" height:30rem; width:30%; box-shadow: 0 1px 20px rgba(1,1,1,.2);margin-top:5rem">
    <img src="/images/avatar2.png" style="display:block;height:10rem;margin:0 auto" /> @*Co daje display block*@
    <form class="form-label">
        
        @if(!string.IsNullOrEmpty(errorMessage))
        {
            <div class="mb-3">
                <label class="label" style="color:red; margin:0 auto" for="errorMessage">Error: @errorMessage</label>
            </div>
        }

        <div class="mb-3">
            <label class="label" for="email">Email: @apiResponseUser.Items.FirstOrDefault().FirstName</label>
        </div>
        <div class="mb-3">
            <label for="firstName">Imię: @apiResponseUser.Items.FirstOrDefault().LastName</label>
        </div>
        <div class="mb-3">
            <label for="lastName">Nazwisko: @apiResponseUser.Items.FirstOrDefault().FirstName</label>
        </div>

    </form>
</div>

<style>
    label{
        font-family:'Gill Sans', 'Gill Sans MT', Calibri, 'Trebuchet MS', sans-serif;
        font-size:1.25rem;
        font-weight:bold;
    }
</style>
@code {
    ApiResponse<UserDto>? apiResponseUser = new();
    string? errorMessage = string.Empty;
    protected async override Task OnInitializedAsync()
    {
        try
        {
            var userId = Guid.Parse("96920D22-9E17-464C-B371-281935CAA738");
            var response = await httpClient.GetAsync($"https://localhost:7041/api/User/{userId}");


            if (response.IsSuccessStatusCode)
            {
                var userDtoResponse = await response.Content.ReadFromJsonAsync<ApiResponse<UserDto>?>();

                if (userDtoResponse != null)
                    apiResponseUser = userDtoResponse;
            }
            else
            {
                var statusCode = response.StatusCode;
                var content = await response.Content.ReadAsStringAsync();
                errorMessage += $"Status code: {statusCode}\n Content: {content}";
            }

            
        }
        catch (Exception ex)
        {
            
            errorMessage += ex.Message;
            Console.WriteLine("XD");
        }
        
    }
}
