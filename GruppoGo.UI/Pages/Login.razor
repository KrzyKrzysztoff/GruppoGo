@page "/login"
@inject NavigationManager NavigationManager

<h3>Login</h3>

<EditForm Model="login" OnSubmit="HandleSubmit">
    <div class="mb-3">
        <label for="username">Username</label>
        <InputText id="username" @bind-Value="login.Email" class="form-control" />
    </div>

    <div class="mb-3">
        <label for="password">Password</label>
        <InputText id="password" @bind-Value="login.Password" type="password" class="form-control" />
    </div>

    <div class="mb-3">
        <label for="confirmPassword">Confirm password</label>
        <InputText id="password" @bind-Value="login.ConfirmPassword" type="password" class="form-control" />
    </div>

    <div class="mb-3">
        <button type="submit" class="btn btn-primary">Send</button>
    </div>
</EditForm>

@code {
    private LoginDto login = new();

    private void HandleSubmit()
    {
        NavigationManager.NavigateTo("/home");
    }
}
